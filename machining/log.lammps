unfix           eq
fix             md   mobile nve                       # all moving atoms
fix             heat sink langevin 300.0 300.0 0.1 4928459   # heat sink layer
fix_modify      heat temp Tsink

# ---------------- 2) tool penetrates the surface ---------------------
fix             down tool move linear 0.0 -${v} 0.0 units box
fix             down tool move linear 0.0 -2 0.0 units box
run             $(round((v_gap+v_depth)/v_v/dt))
run             3000
