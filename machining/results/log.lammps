LAMMPS (22 Jul 2025 - Update 4)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# =====================================================================
#  Quick 3D nanometric cutting of single-crystal aluminium
#  with a rigid diamond tool  (runs in ~15-20 s on 4 cores)
#
#  Workpiece : Al, FCC, a = 4.05 A, EAM (Mendelev et al. 2008)
#              free-standing 3D block, cut on (010) along [-100]
#  Tool      : diamond (C), rigid, rake 0 deg, clearance 10 deg,
#              narrower than the workpiece -> side burrs form (3D)
#  Al-C      : Morse, D0 = 0.28 eV, alpha = 2.78 1/A, r0 = 2.20 A (cutoff 5 A)
#  Speed     : 200 m/s (= 2 A/ps)        Depth of cut : 0.8 nm
#  Length    : 2.0 nm of cutting         Temperature  : 300 K
#
#  Run:     mpirun -np 4 lmp -in in.cutting
#  Output:  dump/cut.*.gz   -> open in OVITO
# =====================================================================

# ---------------- user parameters ------------------------------------
variable  T        equal 300.0      # K
variable  vcut     equal 2.0        # A/ps  (1 A/ps = 100 m/s)
variable  doc      equal 8.0        # depth of cut, A
variable  rake     equal 0.0        # rake angle, deg
variable  clear    equal 10.0       # clearance angle, deg
variable  cutlen   equal 20.0       # tool travel during cutting, A
variable  toolZ    equal 20.0       # tool width (z), A
variable  dt       equal 0.002      # timestep, ps
variable  seed     equal 4928459

variable  aAl      equal 4.05
variable  aC       equal 3.567
variable  nx       equal 16         # ~6.5 nm along cutting direction
variable  ny       equal 8          # ~3.2 nm height
variable  nz       equal 8          # ~3.2 nm width

# ---------------- derived geometry -----------------------------------
variable  L        equal ${nx}*${aAl}
variable  L        equal 16*${aAl}
variable  L        equal 16*4.05
variable  H        equal ${ny}*${aAl}
variable  H        equal 8*${aAl}
variable  H        equal 8*4.05
variable  W        equal ${nz}*${aAl}
variable  W        equal 8*${aAl}
variable  W        equal 8*4.05
variable  xfix     equal 4.0                # fixed layer thickness, A
variable  xthm     equal 12.0               # fixed + thermostat, A
variable  xtip     equal ${L}+6.0           # tool tip starts 0.6 nm away
variable  xtip     equal 64.8+6.0           
variable  ytip     equal ${H}-${doc}
variable  ytip     equal 32.4-${doc}
variable  ytip     equal 32.4-8
variable  toolX    equal 14.0
variable  toolTop  equal ${H}+14.0
variable  toolTop  equal 32.4+14.0
variable  z0       equal 0.5*(${W}-${toolZ})
variable  z0       equal 0.5*(32.4-${toolZ})
variable  z0       equal 0.5*(32.4-20)
variable  z1       equal 0.5*(${W}+${toolZ})
variable  z1       equal 0.5*(32.4+${toolZ})
variable  z1       equal 0.5*(32.4+20)

units           metal
dimension       3
boundary        f f f                       # fixed box: stray atoms are dropped
atom_style      atomic
atom_modify     map array

region          box block -10 $(v_xtip+v_toolX+10) -10 $(v_H+40) -15 $(v_W+15) units box
region          box block -10 94.799999999999997158 -10 $(v_H+40) -15 $(v_W+15) units box
region          box block -10 94.799999999999997158 -10 72.400000000000005684 -15 $(v_W+15) units box
region          box block -10 94.799999999999997158 -10 72.400000000000005684 -15 47.399999999999998579 units box
create_box      2 box
Created orthogonal box = (-10 -10 -15) to (94.8 72.4 47.4)
  2 by 2 by 1 MPI processor grid

# ---------------- workpiece (type 1 = Al) ----------------------------
lattice         fcc ${aAl} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
lattice         fcc 4.05 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
Lattice spacing in x,y,z = 4.05 4.05 4.05
region          work block 0 $(v_L-0.1) 0 $(v_H-0.1) 0 $(v_W-0.1) units box
region          work block 0 64.700000000000002842 0 $(v_H-0.1) 0 $(v_W-0.1) units box
region          work block 0 64.700000000000002842 0 32.299999999999997158 0 $(v_W-0.1) units box
region          work block 0 64.700000000000002842 0 32.299999999999997158 0 32.299999999999997158 units box
create_atoms    1 region work
Created 4096 atoms
  using lattice units in orthogonal box = (-10 -10 -15) to (94.8 72.4 47.4)
  create_atoms CPU = 0.001 seconds

# ---------------- tool (type 2 = C, diamond) -------------------------
variable        rn_x equal  cos(${rake}*PI/180)
variable        rn_x equal  cos(0*PI/180)
variable        rn_y equal  sin(${rake}*PI/180)
variable        rn_y equal  sin(0*PI/180)
variable        cn_x equal -sin(${clear}*PI/180)
variable        cn_x equal -sin(10*PI/180)
variable        cn_y equal  cos(${clear}*PI/180)
variable        cn_y equal  cos(10*PI/180)
region          rakeF  plane ${xtip} ${ytip} 0 ${rn_x} ${rn_y} 0 units box
region          rakeF  plane 70.8 ${ytip} 0 ${rn_x} ${rn_y} 0 units box
region          rakeF  plane 70.8 24.4 0 ${rn_x} ${rn_y} 0 units box
region          rakeF  plane 70.8 24.4 0 1 ${rn_y} 0 units box
region          rakeF  plane 70.8 24.4 0 1 0 0 units box
region          flankF plane ${xtip} ${ytip} 0 ${cn_x} ${cn_y} 0 units box
region          flankF plane 70.8 ${ytip} 0 ${cn_x} ${cn_y} 0 units box
region          flankF plane 70.8 24.4 0 ${cn_x} ${cn_y} 0 units box
region          flankF plane 70.8 24.4 0 -0.17364817766693 ${cn_y} 0 units box
region          flankF plane 70.8 24.4 0 -0.17364817766693 0.984807753012208 0 units box
region          tbox   block ${xtip} $(v_xtip+v_toolX) ${ytip} ${toolTop} ${z0} ${z1} units box
region          tbox   block 70.8 $(v_xtip+v_toolX) ${ytip} ${toolTop} ${z0} ${z1} units box
region          tbox   block 70.8 84.799999999999997158 ${ytip} ${toolTop} ${z0} ${z1} units box
region          tbox   block 70.8 84.799999999999997158 24.4 ${toolTop} ${z0} ${z1} units box
region          tbox   block 70.8 84.799999999999997158 24.4 46.4 ${z0} ${z1} units box
region          tbox   block 70.8 84.799999999999997158 24.4 46.4 6.2 ${z1} units box
region          tbox   block 70.8 84.799999999999997158 24.4 46.4 6.2 26.2 units box
region          tool   intersect 3 rakeF flankF tbox
lattice         diamond ${aC}
lattice         diamond 3.567
Lattice spacing in x,y,z = 3.567 3.567 3.567
create_atoms    2 region tool
Created 1091 atoms
  using lattice units in orthogonal box = (-10 -10 -15) to (94.8 72.4 47.4)
  create_atoms CPU = 0.001 seconds

mass            1 26.9815
mass            2 12.011

# ---------------- interactions ---------------------------------------
pair_style      hybrid eam/fs morse 5.0
pair_coeff      * * eam/fs Al_mm.eam.fs Al NULL
Reading eam/fs potential file Al_mm.eam.fs with DATE: 2007-06-11
pair_coeff      1 2 morse 0.28 2.78 2.20
pair_coeff      2 2 none
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes exclude type 2 2

# ---------------- groups: fixed / thermostat / Newtonian -------------
group           tool   type 2
1091 atoms in group tool
group           al     type 1
4096 atoms in group al
region          rfixL  block INF ${xfix} INF INF INF INF units box
region          rfixL  block INF 4 INF INF INF INF units box
region          rfixB  block INF INF INF ${xfix} INF INF units box
region          rfixB  block INF INF INF 4 INF INF units box
region          rfix   union 2 rfixL rfixB
region          rthmL  block INF ${xthm} INF INF INF INF units box
region          rthmL  block INF 12 INF INF INF INF units box
region          rthmB  block INF INF INF ${xthm} INF INF units box
region          rthmB  block INF INF INF 12 INF INF units box
region          rthm   union 2 rthmL rthmB
group           fixed  region rfix
736 atoms in group fixed
group           fixed  intersect fixed al
736 atoms in group fixed
group           thmall region rthm
2016 atoms in group thmall
group           thmall intersect thmall al
2016 atoms in group thmall
group           thermo subtract thmall fixed
1280 atoms in group thermo
group           newton subtract al thmall
2080 atoms in group newton
group           mobile subtract al fixed
3360 atoms in group mobile

# ---------------- computes -------------------------------------------
compute         pe   all pe/atom
compute         Tnew newton temp
compute         Tthm thermo temp

variable        FxnN equal fcm(tool,x)*1.602176634   # cutting force, nN
variable        FynN equal fcm(tool,y)*1.602176634   # thrust force, nN
variable        FznN equal fcm(tool,z)*1.602176634   # lateral force, nN

# ---------------- equilibration (1 ps) -------------------------------
timestep        ${dt}
timestep        0.002
velocity        mobile create $(2.0*v_T) ${seed} dist gaussian mom yes rot yes   # 2T: half goes into PE
velocity        mobile create 600 ${seed} dist gaussian mom yes rot yes   
velocity        mobile create 600 4928459 dist gaussian mom yes rot yes   
velocity        fixed  set 0 0 0
velocity        tool   set 0 0 0
fix             f_fix  fixed  setforce 0.0 0.0 0.0
fix             f_nve  mobile nve
fix             f_lang thermo langevin ${T} ${T} 0.1 ${seed}
fix             f_lang thermo langevin 300 ${T} 0.1 ${seed}
fix             f_lang thermo langevin 300 300 0.1 ${seed}
fix             f_lang thermo langevin 300 300 0.1 4928459
fix_modify      f_lang temp Tthm

thermo_style    custom step time c_Tnew c_Tthm pe atoms
thermo_modify   lost ignore
thermo          250
run             $(round(1.0/v_dt))
run             500
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 8.5
  ghost atom cutoff = 8.5
  binsize = 4.25, bins = 25 20 15
  3 neighbor lists, perpetual/occasional/extra = 3 0 0
  (1) pair eam/fs, perpetual, skip from (3)
      attributes: half, newton on
