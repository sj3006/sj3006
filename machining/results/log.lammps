reset_timestep  0

# ---------------- cutting --------------------------------------------
# "units box" matters: the default for fix move is lattice units
fix             f_move tool move linear -${vcut} 0.0 0.0 units box
fix             f_move tool move linear -2 0.0 0.0 units box

variable        nsteps equal round(${cutlen}/${vcut}/${dt})
variable        nsteps equal round(20/${vcut}/${dt})
variable        nsteps equal round(20/2/${dt})
variable        nsteps equal round(20/2/0.002)
variable        trav   equal ${vcut}*time
variable        trav   equal 2*time
fix             f_out all print 25 "$(step) $(time) ${trav} ${FxnN} ${FynN} ${FznN} $(c_Tnew)"                 file forces.dat screen no                 title "# step time_ps tool_travel_A Fx_nN Fy_nN Fz_nN T_newton_K"

shell           mkdir dump
dump            d1 all custom/gz 250 dump/cut.*.gz id type element x y z c_pe
dump_modify     d1 sort id element Al C format float %.3f

thermo_style    custom step time v_trav c_Tnew c_Tthm v_FxnN v_FynN atoms
WARNING: New thermo_style command, previous thermo_modify settings will be lost (src/src/output.cpp:912)
thermo_modify   lost ignore
run             ${nsteps}
run             5000
